{
  "version": "2.01",
  "target_apps": {
    "spotify.exe": {
      "enabled": true
    },
    "chrome.exe": {
      "enabled": false
    }
  },
  "trigger_apps": {
    "discord.exe": {
      "enabled": true,
      "duck_volume": 0.25,
      "trigger_threshold": 0.8
    },
    "chrome.exe": {
      "enabled": false,
      "duck_volume": 0.35,
      "trigger_threshold": 0.05
    }
  },
  "duck_on_microphone": false,
  "selected_microphone": "Microphone Array (Intel® Smart Sound Technology for Digital Microphones)",
  "mic_duck_volume": 0.2,
  "mic_peak_threshold": 0.08,
  "transition_duration_seconds": 0.2,
  "release_delay_seconds": 0.2,
  "audio_peak_threshold": 0.005,
  "check_interval_seconds": 0.05,
  "verbose_logging": true
}