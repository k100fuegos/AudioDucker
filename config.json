    "firefox.exe": {
      "enabled": true,
      "duck_volume": 0.35
    },
    "brave.exe": {
      "enabled": true,
      "duck_volume": 0.35
    },
    "telegram.exe": {
      "enabled": true,
      "duck_volume": 0.25
